<?xml version="1.0" encoding="utf-8"?>
<!--
  Login screen logo — same concept as app icon but white pin + green cross
  displayed on the dark blue gradient login background.
  96×96 dp viewport, pin centre (48, 40), radius 20, tip at (48, 72)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Outer pulse ring -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#25FFFFFF"
        android:strokeWidth="2"
        android:pathData="M 48,40 m-40,0 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0" />

    <!-- Mid pulse ring -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#45FFFFFF"
        android:strokeWidth="2"
        android:pathData="M 48,40 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0" />

    <!-- White location pin body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 48,72 C 41,72 28,57 28,40 A 20,20 0 1,1 68,40 C 68,57 55,72 48,72 Z" />

    <!-- Light-blue inset circle -->
    <path
        android:fillColor="#BBDEFB"
        android:pathData="M 48,40 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0" />

    <!-- Green medical cross (18×18, arm width 6, centred at 48,40) -->
    <path
        android:fillColor="#2E7D32"
        android:pathData="M 45,31 H 51 V 37 H 57 V 43 H 51 V 49 H 45 V 43 H 39 V 37 H 45 Z" />

    <!-- Pin tip accent -->
    <path
        android:fillColor="#BBDEFB"
        android:pathData="M 48,72 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />

</vector>
